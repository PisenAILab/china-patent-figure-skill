{
  // 中国专利附图 Skill 的 Codespaces / Dev Containers 配置：打开即装好锁定依赖，`pfk start`（或
  // `python scripts/pfk_cli.py start --no-browser`）后在「端口」面板打开 8790 即是工作台。
  // 与 ci.yml 同一套系统依赖（OCP 的 libGL / libX11、中文字体）；Python 3.11 与 CI 主作业一致。
  // 不配置任何 AI 通道（PFK_AI_PROVIDER=none）：Codespaces 里默认零外发。
  "name": "中国专利附图 Skill",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "containerEnv": {
    "PFK_AI_PROVIDER": "none",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PYTHONUTF8": "1"
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgl1 libx11-6 fonts-noto-cjk && sudo rm -rf /var/lib/apt/lists/*",
  "postCreateCommand": "python -m pip install -U pip && python -m pip install -r requirements-pinned.txt -r requirements-web.txt pyyaml==6.0.3 && python scripts/pfk_cli.py doctor --profile web",
  "postAttachCommand": "echo '启动工作台：python scripts/pfk_cli.py start --no-browser  → 端口面板打开 8790（地址栏带 ?token=…）'",
  "forwardPorts": [8790],
  "portsAttributes": {
    "8790": { "label": "中国专利附图 Skill 工作台", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
